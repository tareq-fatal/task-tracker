# Database — PostgreSQL (dev + prod).
# Local dev: spin up a throwaway Postgres, e.g.
#   docker run -d --name tt-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16-alpine
# then create the DB and point DATABASE_URL at it:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasktracker?schema=public"

# Session secret used to sign session cookies (use a long random string in prod)
SESSION_SECRET="change-me-to-a-long-random-string-please-0123456789"

# Admin seed credentials. REQUIRED by `npm run bootstrap` — there is no default
# and the script refuses to run without them (min. 12 chars). Never reuse the
# value from this example file; generate one, e.g. `openssl rand -base64 24`.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE-ME-generate-a-long-random-password"
ADMIN_EMAIL="admin@task-tracker.local"

# Demo/tenant-admin password (alice / bob / charlie). Same rules as above.
DEMO_PASSWORD="CHANGE-ME-generate-a-long-random-password"

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
# Leave empty to disable push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@task-tracker.local"

# Show the demo-account credentials block on the login page. MUST stay false in
# production. Set to "true" only for local/demo environments.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS="false"

# Sentry error tracking (https://docs.sentry.io/platforms/javascript/guides/nextjs/).
# Leave DSNs empty to disable Sentry entirely (Sentry.init no-ops with no dsn).
# Server/edge DSN — used in sentry.server.config.ts / sentry.edge.config.ts.
SENTRY_DSN=""
# Client DSN — same project, but must be NEXT_PUBLIC_ to reach the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: overrides the "environment" tag (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=""

# Org/project slugs + auth token, needed ONLY at build time to upload source
# maps and tag the release. Get an auth token with "project:releases" scope
# from https://sentry.io/settings/account/api/auth-tokens/ — CI/deploy only,
# never required for local `next dev`.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
# Release name tagged on events + uploaded source maps. Defaults to
# "task-tracker@v3.0.0" in next.config.mjs if left unset.
SENTRY_RELEASE=""
# Public base URL — used for canonical links, sitemap.xml, robots.txt and
# OG/JSON-LD absolute URLs. Defaults to the production domain if unset.
NEXT_PUBLIC_APP_URL="https://tasks.coastshield.net"

# Privacy-friendly analytics (self-hosted Umami, see docs/analytics-umami.md).
# No cookies, no PII — leave both empty to disable analytics entirely.
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# Voice-note transcription (optional, OFF by default). When enabled, uploaded
# voice notes are transcribed via a Whisper API (OpenAI or any compatible
# endpoint, e.g. a local faster-whisper server) and the text is shown under
# the player.
VOICE_TRANSCRIPTION="false"
WHISPER_API_KEY=""
WHISPER_API_URL="https://api.openai.com/v1"
WHISPER_MODEL="whisper-1"
