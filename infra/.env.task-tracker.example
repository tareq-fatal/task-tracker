# =============================================================================
# Task Tracker — production environment.
# Copy to `.env.task-tracker` next to the compose file ON THE VPS and fill in.
# NEVER commit the filled-in file.
#
#   cp .env.task-tracker.example .env.task-tracker && nano .env.task-tracker
# =============================================================================

# --- Database -----------------------------------------------------------------
# Points at the EXISTING Coast-Shield Postgres. The host is the Postgres
# container's service name on the shared docker network (e.g. `postgres` or `db`
# — confirm with `docker compose ps`). Create a dedicated DB + user first:
#
#   docker exec -it <postgres-container> psql -U postgres -c \
#     "CREATE USER tasktracker WITH PASSWORD 'CHANGE-ME-strong';"
#   docker exec -it <postgres-container> psql -U postgres -c \
#     "CREATE DATABASE tasktracker OWNER tasktracker;"
#
DATABASE_URL="postgresql://tasktracker:CHANGE-ME-strong@postgres:5432/tasktracker?schema=public"

# --- Auth ---------------------------------------------------------------------
# Sign session cookies. Generate a fresh one:  openssl rand -hex 32
SESSION_SECRET="CHANGE-ME-run-openssl-rand-hex-32"

# --- Seed credentials (used only by the one-off `prisma db seed`) -------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE-ME-admin-password"
ADMIN_EMAIL="admin@coastshield.net"
DEMO_PASSWORD="CHANGE-ME-demo-password"

# --- Web Push (optional) ------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# Leave empty to disable push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@coastshield.net"
