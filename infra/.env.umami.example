# Umami self-hosted analytics — VPS env file (.env.umami, NOT committed).
#
# Postgres password for the umami-db service.
UMAMI_DB_PASSWORD="change-me-to-a-long-random-string"

# Signs Umami's own admin-dashboard session cookies (not visitor tracking).
# Generate with: openssl rand -hex 32
UMAMI_APP_SECRET="change-me-to-a-long-random-string"
