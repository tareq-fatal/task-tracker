# =============================================================================
# Task Tracker — backup automation environment.
# Copy to `.env.backup` next to infra/backup.sh (or wherever the systemd
# EnvironmentFile= / docker-compose.backup.yml env_file: points), then fill in.
# NEVER commit the filled-in file.
#
#   cp .env.backup.example .env.backup && nano .env.backup
# =============================================================================

# --- Database (PostgreSQL on the existing Coast-Shield instance) -------------
# Either fill in DATABASE_URL, OR the individual PGHOST/PGPORT/PGUSER/PGPASSWORD/
# PGDATABASE vars below — DATABASE_URL wins if both are set. Same credentials
# as infra/.env.task-tracker.example's DATABASE_URL (reuse the `tasktracker`
# user, it only needs read access for pg_dump).
#
# DATABASE_URL="postgresql://tasktracker:CHANGE-ME-strong@postgres:5432/tasktracker?schema=public"
PGHOST="postgres"
PGPORT="5432"
PGUSER="tasktracker"
PGPASSWORD="CHANGE-ME-strong"
PGDATABASE="tasktracker"

# --- Uploads volume ------------------------------------------------------------
UPLOADS_VOLUME="task_tracker_uploads"
# "docker-volume" = resolve mountpoint via `docker volume inspect` (run backup.sh
# on the VPS host). Set to "/uploads" if running inside the backup sidecar
# container from docker-compose.backup.yml (volume mounted read-only there).
UPLOADS_SOURCE="docker-volume"

# --- rclone remote: pick ONE backend, comment out the other ------------------
# rclone is configured entirely via env vars (RCLONE_CONFIG_<REMOTE>_*), no
# on-disk rclone.conf needed. RCLONE_REMOTE below is the logical remote name
# referenced by backup.sh/restore.sh — it must match the suffix used in the
# RCLONE_CONFIG_* vars (uppercased remote name).
RCLONE_REMOTE="backup"

# --- Option A: Backblaze B2 --------------------------------------------------
# Create an "Application Key" scoped to a single bucket in the B2 console.
RCLONE_CONFIG_BACKUP_TYPE="b2"
RCLONE_CONFIG_BACKUP_ACCOUNT="CHANGE-ME-b2-key-id"
RCLONE_CONFIG_BACKUP_KEY="CHANGE-ME-b2-application-key"

# --- Option B: MinIO (or any S3-compatible endpoint) -------------------------
# Uncomment these and comment out the B2 block above instead.
# RCLONE_CONFIG_BACKUP_TYPE="s3"
# RCLONE_CONFIG_BACKUP_PROVIDER="Minio"
# RCLONE_CONFIG_BACKUP_ENDPOINT="https://minio.coastshield.net"
# RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID="CHANGE-ME-minio-access-key"
# RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY="CHANGE-ME-minio-secret-key"

# Bucket + key prefix. Final object layout:
#   <bucket>/<KEY_PREFIX>/YYYY-MM-DD/db.sql.gz
#   <bucket>/<KEY_PREFIX>/YYYY-MM-DD/uploads.tar.gz
RCLONE_BUCKET="CHANGE-ME-bucket-name"
KEY_PREFIX="backups/tasktracker"

# --- Retention -----------------------------------------------------------------
RETENTION_DAYS="30"

# --- Notifications (both optional — leave empty to disable) -------------------
# Incoming webhook URL from a Slack app (Incoming Webhooks feature).
SLACK_WEBHOOK_URL=""
# Recipient for failure emails. Requires a working local MTA (postfix/exim) or
# msmtp configured as /usr/sbin/sendmail on the host running backup.sh.
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM="task-tracker-backup@coastshield.net"
