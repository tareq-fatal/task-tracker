// Task Tracker — Prisma schema
// PostgreSQL (production + dev). Enums are stored as strings;
// allowed values are validated in the app layer (src/lib/enums.ts + zod schemas).
//
// binaryTargets: "native" covers local dev; "debian-openssl-3.0.x" covers the
// production container (node:20-bookworm-slim → OpenSSL 3.0). If you ever build
// on an Alpine/musl base instead, add "linux-musl-openssl-3.0.x".

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique // "objektus", "tarek", "marine"
  name         String
  logo         String?
  primaryColor String?
  ssoDomains   String? // comma-separated email domains routed to this tenant (e.g. "objektus.de")
  createdAt    DateTime @default(now())

  users         User[]
  projects      Project[]
  teams         Team[]
  tasks         Task[]
  authProviders TenantAuthProvider[]
  plannerSyncs  PlannerSync[]
  sprints       Sprint[]
}

model Sprint {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("planned") // planned | active | closed
  createdAt DateTime  @default(now())

  tasks Task[]

  @@index([tenantId])
  @@index([projectId])
}

model PlannerSync {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String    @unique // the local project mirrored to/from the plan
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId       String // MS Graph Planner plan id
  groupId      String? // owning M365 group id (needed for some Graph calls)
  direction    String    @default("pull") // "pull" | "push" | "two-way"
  enabled      Boolean   @default(true)
  intervalMin  Int       @default(5) // polling cadence for the scheduler
  lastSyncedAt DateTime?
  lastStatus   String? // last run summary (ok / error message)
  deltaLink    String? // Graph delta query continuation token
  createdAt    DateTime  @default(now())

  @@unique([tenantId, planId])
  @@index([tenantId])
}

model TenantAuthProvider {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider      String // "azure-ad" | "google" | "github" | "apple"
  enabled       Boolean  @default(true)
  autoProvision Boolean  @default(true) // auto-create a user on first SSO login
  createdAt     DateTime @default(now())

  @@unique([tenantId, provider])
}

model UserIdentity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String // the provider's stable subject id
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique // login id — globally unique (unambiguous login)
  email        String // unique per tenant (see @@unique below)
  passwordHash String
  role         String   @default("User") // "SuperAdmin" | "Admin" | "User"
  avatar       String? // url or emoji
  locale       String   @default("ar") // "ar" | "en" | "de"
  hasSeenTour  Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Notification global settings
  quietHoursStart Int? // 0-23 local hour; null = off
  quietHoursEnd   Int?
  notifyDigest    Boolean @default(false) // batch email instead of instant

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessions          Session[]
  assignedTasks     Task[]             @relation("AssignedTo")
  createdTasks      Task[]             @relation("CreatedBy")
  createdProjects   Project[]          @relation("ProjectCreatedBy")
  comments          TaskComment[]
  pushSubscriptions PushSubscription[]
  teamMemberships   TeamMember[]
  createdTeams      Team[]             @relation("TeamCreatedBy")
  identities        UserIdentity[]
  activity          ActivityLog[]
  notifications     Notification[]
  notifyPrefs       NotificationPreference[]
  notifyDevices     NotificationDevice[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  type      String // assigned | status | comment | mention | due_soon | overdue | blocker_resolved | recurring
  title     String
  body      String?
  url       String?
  taskId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  inApp     Boolean @default(true)
  webPush   Boolean @default(true)
  email     Boolean @default(false)
  native    Boolean @default(true)

  @@unique([userId, eventType])
}

model NotificationDevice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // "android" | "ios"
  token     String   @unique // FCM / APNs token
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id              String   @id @default(cuid())
  name            String
  description     String?
  color           String   @default("#0ea5e9")
  createdAt       DateTime @default(now())
  createdByUserId String
  createdBy       User     @relation("TeamCreatedBy", fields: [createdByUserId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members TeamMember[]
  tasks   Task[]

  @@index([tenantId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  color         String   @default("#6366f1") // indigo
  externalId    String?  @unique // e.g. MS Planner plan id (import idempotency)
  createdAt     DateTime @default(now())
  createdByUserId String
  createdBy     User     @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tasks       Task[]
  plannerSync PlannerSync?
  sprints     Sprint[]
  columns     WorkflowColumn[]

  @@index([tenantId])
}

model WorkflowColumn {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  wipLimit  Int? // max tasks allowed in this column (null = unlimited)
  isInitial Boolean  @default(false) // new tasks land here
  isFinal   Boolean  @default(false) // tasks here count as completed
  status    String   @default("InProgress") // underlying base status: Todo | InProgress | Done
  createdAt DateTime @default(now())

  tasks Task[]

  @@index([projectId])
  @@index([tenantId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("Todo") // Todo | InProgress | Done | Archived
  priority    String    @default("Medium") // Low | Medium | High | Critical
  position    Int       @default(0) // ordering within a status column
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // External system linkage (MS Planner import idempotency)
  externalId String? @unique
  bucket     String? // original MS Planner bucket name, kept for reference

  // Issue hierarchy: Epic > Story > Task > Subtask (Bug anywhere).
  type        String  @default("Task") // Epic | Story | Task | Subtask | Bug
  parentId    String?
  parent      Task?   @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Task[]  @relation("TaskHierarchy")
  storyPoints Int?

  // Scrum-board column (to-do | in-progress | waiting | to-verify | done |
  // ready-for-golive). Null → derived from status. Independent of `bucket`.
  scrumColumn String?

  // Recurrence (iCal RRULE subset, e.g. "FREQ=WEEKLY;BYDAY=MO,WE"). When set, a
  // cron spawns the next instance at recurringNextAt.
  recurringRule  String?
  recurringNextAt DateTime?

  // Progress (0-100). Auto-derived from subtasks when any exist, else manual.
  progress Int @default(0)

  // Time tracking (hours)
  estimatedHours Float?
  spentHours     Float     @default(0)
  timerStartedAt DateTime? // when a running timer was started (null = stopped)
  completedAt    DateTime? // set when status becomes Done

  assignedToUserId String?
  assignedTo       User?   @relation("AssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdByUserId String
  createdBy       User    @relation("CreatedBy", fields: [createdByUserId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  // Optional per-project custom workflow column. When a project defines columns,
  // its board groups by this instead of `status`. Null = fall back to status board.
  workflowColumnId String?
  workflowColumn   WorkflowColumn? @relation(fields: [workflowColumnId], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  comments    TaskComment[]
  attachments TaskAttachment[]
  subtasks    Subtask[]
  linksFrom   TaskLink[]       @relation("LinksFrom")
  linksTo     TaskLink[]       @relation("LinksTo")
  activity    ActivityLog[]

  @@index([status])
  @@index([assignedToUserId])
  @@index([projectId])
  @@index([teamId])
  @@index([sprintId])
  @@index([parentId])
  @@index([tenantId])
  @@index([workflowColumnId])
}

model TaskLink {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation("LinksFrom", fields: [taskId], references: [id], onDelete: Cascade)
  linkedTaskId String
  linkedTask   Task     @relation("LinksTo", fields: [linkedTaskId], references: [id], onDelete: Cascade)
  type         String // DependsOn | Blocks | RelatedTo | SubtaskOf
  createdAt    DateTime @default(now())

  @@unique([taskId, linkedTaskId, type])
  @@index([taskId])
  @@index([linkedTaskId])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model DbAuditLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  sql       String
  mode      String // "read" | "write" | "purge"
  rowCount  Int?
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // created | status | assigned | priority | comment | due | reopened
  detail    String? // human-readable detail (e.g. "Todo → Done")
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String // public path, e.g. /uploads/xxxx.png
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())

  @@index([taskId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
