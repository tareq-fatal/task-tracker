# =============================================================================
# Keep the build context minimal: only what `next build` + `prisma generate`
# need. Everything reinstalled/rebuilt in-image, all secrets, and all local
# cruft is excluded. Smaller context = faster uploads + no accidental leaks.
# =============================================================================

# --- Dependencies & build output (reinstalled / rebuilt inside the image) ----
node_modules
.next
out
build
dist

# --- Secrets & local env — provided at runtime, NEVER baked into the image ---
.env
.env.*
!.env.example
secrets
*.pem
*.key

# --- Version control & CI ----------------------------------------------------
.git
.gitignore
.gitattributes
.github
.claude

# --- Local databases (PostgreSQL is used in prod) ----------------------------
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# --- Generated PWA service worker (regenerated by `next build`) --------------
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js

# --- Uploaded files (persisted via a volume, not baked into the image) -------
public/uploads/*

# --- Mobile / Capacitor (not part of the web image) --------------------------
android
ios
capacitor.config.ts

# --- Tests, tooling & docs not needed at build time --------------------------
e2e
e2e-live
test-results
playwright-report
.playwright
screenshots
playwright.config.ts
playwright.live.config.ts
vitest.config.ts
*.tsbuildinfo
coverage
docs
releases
scripts
DEPLOY.md
README.md
*.md

# --- Archives / misc large artifacts -----------------------------------------
*.tar
*.tar.gz
*.tgz
*.zip

# --- Docker & compose (not needed inside the image) --------------------------
Dockerfile
.dockerignore
docker-compose*.yml
infra

# --- Editor / OS cruft -------------------------------------------------------
.vscode
.idea
.DS_Store
Thumbs.db
npm-debug.log*
yarn-error.log*
