# Dependencies & build output (reinstalled / rebuilt inside the image)
node_modules
.next
out
build

# Version control & CI
.git
.gitignore
.github

# Local env & secrets — provided at runtime via compose, never baked in
.env
.env*.local

# Local SQLite databases (we use PostgreSQL in production)
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal

# Generated PWA service worker (regenerated by `next build`)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/fallback-*.js

# Uploaded files (persisted via a volume, not baked into the image)
public/uploads/*

# Tests, tooling & docs not needed at build time
e2e
test-results
playwright-report
.playwright
screenshots
playwright.config.ts
vitest.config.ts
*.tsbuildinfo

# Editor / OS cruft
.vscode
.idea
.DS_Store
npm-debug.log*
Dockerfile
.dockerignore
