  "paths": {
    "/api/auth/{provider}/start": {
      "get": {
        "summary": "Begin OAuth sign-in",
        "description": "Kicks off the OAuth 2.0 authorization-code flow: generates a CSRF `state`, stores it in the `tt_sso_state` cookie (10-min TTL) and redirects the browser to the provider's authorize URL. If the provider is unknown or unconfigured, redirects to `/login?sso=unavailable` instead.",
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "description": "SSO identity provider.",
            "schema": {
              "$ref": "#/components/schemas/SsoProvider"
            }
          }
        ],
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to the provider's authorization endpoint.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "example": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize?..."
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Session / state cookie side-effects where applicable."
              }
            }
          }
        }
      }
    },
    "/api/auth/{provider}/callback": {
      "get": {
        "summary": "OAuth callback (query mode)",
        "description": "Provider redirect target for `response_type=code` (Azure-AD, Google, GitHub). Validates `state` against the `tt_sso_state` cookie, exchanges the code, resolves the user (link existing identity, route by email domain to a tenant, or auto-provision when enabled), then sets the `tt_session` cookie and redirects to `/`. On any failure redirects to `/login?sso={reason}`.",
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "description": "SSO identity provider.",
            "schema": {
              "$ref": "#/components/schemas/SsoProvider"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Authorization code from the provider."
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must match the `tt_sso_state` cookie."
          }
        ],
        "security": [],
        "responses": {
          "302": {
            "description": "Success → redirect to `/` with a fresh `tt_session` cookie. Failure → redirect to `/login?sso={reason}` where reason ∈ {unavailable, state, exchange, profile, no_tenant, disabled, no_account}.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "example": "/"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "example": "tt_session=…; HttpOnly; Path=/; SameSite=Lax"
              }
            }
          }
        }
      },
      "post": {
        "summary": "OAuth callback (form_post mode)",
        "description": "Provider redirect target for `response_mode=form_post` (Apple). Same logic as the GET callback but reads `code`/`state` from the posted form body.",
        "tags": [
          "Authentication"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "description": "SSO identity provider.",
            "schema": {
              "$ref": "#/components/schemas/SsoProvider"
            }
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "code",
                  "state"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to `/` (success) or `/login?sso={reason}` (failure).",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "example": "/"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Session / state cookie side-effects where applicable."
              }
            }
          }
        }
      }
    },
    "/api/cron/notifications": {
      "get": {
        "summary": "Run due-reminder notifications",
        "description": "Sends due-soon and overdue reminders. Idempotent to run repeatedly; typically scheduled once daily (`0 7 * * *`). Accepts GET and POST identically.",
        "security": [
          {
            "syncSecret": []
          }
        ],
        "tags": [
          "Cron & sync"
        ],
        "responses": {
          "200": {
            "description": "Job ran.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CronResult"
                },
                "example": {
                  "ok": true,
                  "dueSoon": 3,
                  "overdue": 1
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong `x-sync-secret`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          },
          "503": {
            "description": "`SYNC_SECRET` is not configured on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "disabled (no SYNC_SECRET)"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Run due-reminder notifications",
        "description": "Sends due-soon and overdue reminders. Idempotent to run repeatedly; typically scheduled once daily (`0 7 * * *`). Accepts GET and POST identically.",
        "security": [
