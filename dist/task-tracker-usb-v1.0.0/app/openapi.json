    "/api/push": {
      "post": {
        "summary": "Register a Web-Push subscription",
        "description": "Upserts the caller's browser push subscription (keyed by `endpoint`) so the server can deliver notifications. Requires an authenticated session.",
        "tags": [
          "Web Push"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSubscription"
              },
              "example": {
                "endpoint": "https://fcm.googleapis.com/fcm/send/abc123",
                "keys": {
                  "p256dh": "BENc7...mocth",
                  "auth": "tBHIt...9s7A"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "400": {
            "description": "Missing `endpoint` or keys.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid"
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove a Web-Push subscription",
        "description": "Deletes the caller's subscription for the given `endpoint`. Idempotent.",
        "tags": [
          "Web Push"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushUnsubscribe"
              },
              "example": {
                "endpoint": "https://fcm.googleapis.com/fcm/send/abc123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Removed (or nothing matched).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "ok": true
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "unauthorized"
                }
              }
            }
          }
        }
      }
    },
    "/download/attachment/{id}": {
      "get": {
        "summary": "Download a task attachment",
        "description": "Streams an attachment as a forced download (`Content-Disposition: attachment`, `application/octet-stream`). Access is tenant-scoped: the caller must be in the attachment's tenant AND be an admin, the task creator, or the assignee.",
        "tags": [
          "Attachments"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "TaskAttachment id."
          }
        ],
        "responses": {
          "200": {
            "description": "The file bytes.",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "example": "attachment; filename*=UTF-8''report.pdf"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "private, no-store"
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated but not allowed to view the task.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Forbidden"
              }
            }
          },
          "404": {
            "description": "Not found, wrong tenant, or file missing on disk.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Not found"
              }
            }
          }
        }
      }
    },
    "/t/{slug}": {
      "get": {
        "summary": "Switch active tenant (BackendAdmin)",
        "description": "Path-based tenant entry. For a BackendAdmin/SuperAdmin, sets the `tt_tenant` cookie to the given tenant slug and redirects to `/`. For other roles the cookie is left unchanged (they are hard-locked to their own tenant). Unauthenticated → `/login`.",
        "tags": [
          "Tenancy"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Tenant slug.",
            "example": "coast-shield"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to `/` (tenant cookie set for BackendAdmin) or `/login`.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "example": "/"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Session / state cookie side-effects where applicable."
              }
            }
          }
        }
      }
    },
    "/logout": {
      "get": {
        "summary": "Log out",
        "description": "Destroys the current session (deletes the DB row and clears `tt_session`) and redirects to `/login`. A plain GET navigation so it works inside the Capacitor WebView, where form-POST Server Actions were unreliable.",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to `/login`; `tt_session` cleared; `Cache-Control: no-store`.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "example": "/login"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "Session / state cookie side-effects where applicable."
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "description": "Returns this specification as JSON. Powers the Swagger-UI at `/api-docs`.",
        "tags": [
          "Meta"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The OpenAPI 3.1 document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tt_session",
        "description": "Primary end-user authentication. An opaque, server-generated session token stored as an httpOnly cookie and backed by a `Session` row (30-day expiry). Set by password login (Server Action) or the OAuth callback; cleared by `GET /logout`. Not a JWT — the token carries no claims."
      },
      "syncSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "x-sync-secret",
        "description": "Shared-secret guard for machine-to-machine cron/sync endpoints. The value must equal the server's `SYNC_SECRET` env var. When `SYNC_SECRET` is unset the endpoints return `503`."
      },
      "oauth2": {
        "type": "oauth2",
        "description": "SSO sign-in via an identity provider (Microsoft/Azure-AD, Google, GitHub, Apple). The browser is redirected through the provider; on return the server verifies the provider's `id_token` (a JWT) and issues its own `tt_session` cookie. This is a redirect flow driven by `/api/auth/{provider}/start` and `/api/auth/{provider}/callback`, not a token the client sends to this API.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/api/auth/azure-ad/start",
            "tokenUrl": "/api/auth/azure-ad/callback",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "BackendAdmin",
          "Admin",
          "User"
        ],
        "description": "User role. `BackendAdmin` (legacy `SuperAdmin`) spans all tenants."
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "Todo",
          "InProgress",
          "Done",
          "Archived"
        ],
        "description": "Task lifecycle status."
      },
      "TaskPriority": {
        "type": "string",
        "enum": [
          "Low",
          "Medium",
          "High",
          "Critical"
        ],
        "description": "Task priority."
      },
      "TaskType": {
        "type": "string",
        "enum": [
          "Epic",
          "Story",
          "Task",
          "Subtask",
          "Bug"
        ],
        "description": "Issue hierarchy type (Epic > Story > Task > Subtask; Bug with Task)."
      },
      "TaskLinkType": {
        "type": "string",
        "enum": [
          "DependsOn",
          "Blocks",
          "RelatedTo",
          "SubtaskOf"
        ],
        "description": "Relationship between two tasks."
      },
      "Locale": {
        "type": "string",
        "enum": [
          "ar",
          "en",
          "de"
        ],
        "description": "UI locale. `ar` is the default (RTL)."
      },
      "SsoProvider": {
        "type": "string",
        "enum": [
          "azure-ad",
          "google",
          "github",
          "apple"
        ],
        "description": "Configured OAuth/OIDC identity providers."
      },
      "Login": {
        "type": "object",
        "description": "Credentials for password login (`loginSchema`).",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "example": "tarek"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "format": "password",
            "example": "s3cret-pass"
          }
        }
      },
      "Task": {
        "type": "object",
        "description": "Task create/update payload (`taskSchema`). Duration fields accept shorthands (\"4h\", \"1d\", \"90m\") that are parsed to hours server-side.",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Ship OpenAPI docs"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "default": "",
            "example": "Generate the 3.1 spec and serve Swagger-UI."
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus",
            "default": "Todo"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority",
            "default": "Medium"
          },
          "assignedToUserId": {
            "type": "string",
            "nullable": true,
            "example": "clv0userid"
          },
          "projectId": {
            "type": "string",
            "nullable": true,
            "example": "clv0projid"
          },
          "teamId": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2026-07-31"
          },
          "estimatedHours": {
            "type": "string",
            "nullable": true,
            "description": "Shorthand like \"4h\" / \"2d\".",
            "example": "1d"
          },
          "spentHours": {
            "type": "string",
            "nullable": true,
            "description": "Shorthand like \"90m\".",
            "example": "2h"
          }
        }
      },
      "Subtask": {
        "type": "object",
        "description": "Subtask create payload (`subtaskSchema`).",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Write examples"
          }
        }
      },
      "Progress": {
        "type": "object",
        "description": "Progress update (`progressSchema`).",
        "required": [
          "progress"
        ],
        "properties": {
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "example": 60
          }
        }
      },
      "Project": {
        "type": "object",
        "description": "Project create/update payload (`projectSchema`).",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Coast Shield"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": "",
            "example": "Maritime awareness programme."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#6366f1",
            "example": "#0ea5e9"
          }
        }
      },
      "Team": {
        "type": "object",
        "description": "Team create/update payload (`teamSchema`).",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Platform"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "default": "",
            "example": "Owns the core app."
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#4f46e5",
            "example": "#4f46e5"
          }
        }
      },
      "User": {
        "type": "object",
        "description": "User create/update payload (`userSchema`). `email` and `password` may be empty strings: empty email = no email, empty password = a temporary one is generated.",
        "required": [
          "name",
          "username"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Tarek Fatal"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "example": "tarek.fatal"
          },
          "email": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  ""
                ]
              },
              {
                "type": "string",
                "format": "email"
              }
            ],
            "default": "",
            "example": "tarek@coastshield.net"
          },
          "password": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  ""
                ]
              },
              {
                "type": "string",
                "minLength": 6
              }
            ],
            "default": "",
            "format": "password",
            "example": ""
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "User"
          }
        }
      },
      "Comment": {
        "type": "object",
        "description": "Task comment (`commentSchema`).",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "example": "Looks good — merging."
          }
        }
      },
      "Settings": {
        "type": "object",
        "description": "Account settings (`settingsSchema`). `newPassword`, when present, must be ≥ 6 chars.",
        "required": [
          "locale"
        ],
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "newPassword": {
            "type": "string",
            "minLength": 6,
            "nullable": true,
            "format": "password",
            "example": "brand-new-pw"
          }
        }
      },
      "PushSubscription": {
        "type": "object",
        "description": "W3C Push API subscription forwarded from the browser. Shape matches `PushSubscription.toJSON()`; the route reads `endpoint` and `keys.{p256dh,auth}`.",
        "required": [
          "endpoint",
          "keys"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri",
            "example": "https://fcm.googleapis.com/fcm/send/abc123"
          },
          "expirationTime": {
            "type": "integer",
            "nullable": true,
            "example": null
          },
          "keys": {
            "type": "object",
            "required": [
              "p256dh",
              "auth"
            ],
            "properties": {
              "p256dh": {
                "type": "string",
                "example": "BENc7...mocth"
              },
              "auth": {
                "type": "string",
                "example": "tBHIt...9s7A"
              }
            }
          }
        }
      },
      "PushUnsubscribe": {
        "type": "object",
        "description": "Endpoint identifying the subscription to remove.",
        "required": [
          "endpoint"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri",
            "example": "https://fcm.googleapis.com/fcm/send/abc123"
          }
        }
      },
      "CronResult": {
        "type": "object",
        "description": "Result envelope from a cron/sync run. Extra keys depend on the job.",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "dueSoon": {
            "type": "integer",
            "description": "notifications job — reminders sent for soon-due tasks."
          },
          "overdue": {
            "type": "integer",
            "description": "notifications job — reminders sent for overdue tasks."
          },
          "created": {
            "type": "integer",
            "description": "recurring job — task instances created."
          },
          "ran": {
            "type": "integer",
            "description": "planner sync job — number of tenant syncs executed."
          }
        },
        "required": [
          "ok"
        ]
      },
      "Error": {
        "type": "object",
        "description": "Uniform error envelope returned by the JSON endpoints.",
        "properties": {
          "error": {
            "type": "string",
            "example": "unauthorized"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  },
  "x-allowed-upload-mime-types": [
    "image/png",
    "image/jpeg",
    "image/gif",
    "image/webp",
    "application/pdf",
    "application/msword",
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "application/vnd.ms-excel",
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "application/vnd.ms-powerpoint",
    "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    "text/plain",
    "text/csv",
    "application/zip"
  ]
}
