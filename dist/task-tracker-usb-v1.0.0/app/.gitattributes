# Normalize line endings. Shell scripts and Docker assets MUST stay LF —
# CRLF in docker-entrypoint.sh would break the container ("no such file or
# directory" on the shebang).
* text=auto eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Treat as binary (no EOL munging)
*.png binary
*.jpg binary
*.ico binary
*.db  binary
*.woff  binary
*.woff2 binary
