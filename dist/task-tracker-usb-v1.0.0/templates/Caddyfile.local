# Task Tracker — Caddy config for LAN / no-domain installs (generated by
# install.sh, safe to edit).
#
# No public domain was given, so there is no Let's Encrypt certificate: the app
# is served over plain HTTP on the host's port __HTTP_PORT__. Fine for an
# isolated office LAN; put a real domain in front of it before exposing the
# server to the internet (re-run install.sh, or edit this file and restart).
#
# After editing:  docker compose restart caddy

{
	# No ACME — nothing here needs a public DNS name.
	auto_https off
}

:80 {
	encode zstd gzip

	reverse_proxy app:3000

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body {
		max_size 12MB
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
