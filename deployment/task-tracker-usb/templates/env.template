# =============================================================================
# Task Tracker — configuration.  GENERATED BY install.sh — KEEP THIS FILE SAFE.
#
# It contains every password and secret of this installation. It is chmod 600
# (owner-readable only). If you lose it you can still reach your data, but the
# session cookies of all logged-in users become invalid.
#
# After changing anything here:   ./update.sh --restart
#
# WARNING: the three NEXT_PUBLIC_* values are compiled INTO the app image when
# it is built. Editing them here alone has no effect — you must rebuild:
#   ./update.sh --rebuild        (needs an internet connection)
# =============================================================================

# --- Version / image tag -----------------------------------------------------
TT_VERSION=__TT_VERSION__

# --- Public address ----------------------------------------------------------
# The domain this instance is reached at. Empty = LAN / IP-only install.
TT_DOMAIN=__TT_DOMAIN__
# Host ports Caddy binds. Change only if 80/443 are already taken.
TT_HTTP_PORT=__TT_HTTP_PORT__
TT_HTTPS_PORT=__TT_HTTPS_PORT__

# --- Database ----------------------------------------------------------------
POSTGRES_USER=tasktracker
POSTGRES_DB=tasktracker
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# The app talks to Postgres over the internal Docker network, never the host.
DATABASE_URL=postgresql://tasktracker:__POSTGRES_PASSWORD__@postgres:5432/tasktracker?schema=public

# --- Secrets (generated once at install time) --------------------------------
# Signs the session cookies. Changing it logs everybody out.
SESSION_SECRET=__SESSION_SECRET__
# Shared secret for the /api/cron/* and /api/sync/* endpoints.
SYNC_SECRET=__SYNC_SECRET__

# --- Web Push (browser notifications) ----------------------------------------
# VAPID keypair, generated at install time. The PUBLIC key is baked into the
# app image at build time (see the warning at the top of this file).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=__VAPID_PUBLIC_KEY__
VAPID_PRIVATE_KEY=__VAPID_PRIVATE_KEY__
VAPID_SUBJECT=mailto:__ADMIN_EMAIL__

# --- App ---------------------------------------------------------------------
# Used for canonical links, sitemap.xml and OG tags. Baked in at build time.
NEXT_PUBLIC_APP_URL=__APP_URL__
# Demo credentials block on the login page — MUST stay false in production.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false

# --- Administrator account ---------------------------------------------------
# Created once by install.sh. Changing these values here does NOT change the
# existing login — use the app's own user administration instead.
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_EMAIL=__ADMIN_EMAIL__

# --- Optional integrations (all disabled by default) -------------------------
# Error tracking — https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Telegram notifications — see docs/telegram-bot-setup.md in the app repo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Outbound email (password resets, digests) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=
# Voice-note transcription via a Whisper-compatible API.
VOICE_TRANSCRIPTION=false
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
