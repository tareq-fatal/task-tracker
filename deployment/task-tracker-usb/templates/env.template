# =============================================================================
# Task Tracker — configuration.  GENERATED BY install.sh — KEEP THIS FILE SAFE.
#
# It contains every password and secret of this installation. It is chmod 600
# (owner-readable only). If you lose it you can still reach your data, but the
# session cookies of all logged-in users become invalid.
#
# After changing anything here:   ./update.sh --restart
#
# WARNING: the NEXT_PUBLIC_* values are compiled INTO the app image when it is
# built. Editing them here alone has no effect — you must rebuild:
#   ./update.sh --rebuild        (needs an internet connection and the source)
# Offline installs run a pre-built image: there they come from the bundle
# (images/build-info.env), see docs/OFFLINE.md. The instance NAME (APP_NAME) and
# the address (APP_URL) are runtime settings — ./update.sh --restart is enough.
# =============================================================================

# --- Version / image tag -----------------------------------------------------
TT_VERSION=__TT_VERSION__

# --- Public address ----------------------------------------------------------
# TOF-0794 (Tarek 31.10.2026): TLS mode chosen at install time —
#   domain   = Let's Encrypt for TT_DOMAIN (needs internet + public DNS)
#   internal = Caddy's own local CA for TT_HOST / TT_IPS (no internet needed)
#   http     = plain HTTP on the LAN, no certificate at all
TT_TLS_MODE=__TT_TLS_MODE__
# The domain this instance is reached at (--tls domain only).
TT_DOMAIN=__TT_DOMAIN__
# --tls internal: host name and/or LAN IP address(es, comma-separated) the
# certificate is issued for.
TT_HOST=__TT_HOST__
TT_IPS=__TT_IPS__
# The address users open; also the base of invite links (invite.sh).
TT_PUBLIC_URL=__APP_URL__
# Host ports Caddy binds. Change only if 80/443 are already taken.
TT_HTTP_PORT=__TT_HTTP_PORT__
TT_HTTPS_PORT=__TT_HTTPS_PORT__

# --- Database ----------------------------------------------------------------
POSTGRES_USER=tasktracker
POSTGRES_DB=tasktracker
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
# The app talks to Postgres over the internal Docker network, never the host.
DATABASE_URL=postgresql://tasktracker:__POSTGRES_PASSWORD__@postgres:5432/tasktracker?schema=public

# --- Secrets (generated once at install time) --------------------------------
# Signs the session cookies. Changing it logs everybody out.
SESSION_SECRET=__SESSION_SECRET__
# Shared secret for the /api/cron/* and /api/sync/* endpoints.
SYNC_SECRET=__SYNC_SECRET__

# --- Web Push (browser notifications) ----------------------------------------
# VAPID keypair, generated at install time. The PUBLIC key is baked into the
# app image at build time (see the warning at the top of this file).
# Offline installs leave both EMPTY: Web Push is delivered through the browser
# vendors' push services on the internet (docs/OFFLINE.md).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=__VAPID_PUBLIC_KEY__
VAPID_PRIVATE_KEY=__VAPID_PRIVATE_KEY__
VAPID_SUBJECT=mailto:__ADMIN_EMAIL__

# --- Offline / no outside connections (TOF-0794) -----------------------------
# 1 = this server has no internet: /api-docs shows a local hint instead of
# loading Swagger-UI from a CDN. Every other outside call of the app only runs
# when its service is configured below — see docs/OFFLINE.md.
TT_OFFLINE=__TT_OFFLINE__
# never = compose must not pull images (offline: all images come from images/).
TT_PULL_POLICY=__TT_PULL_POLICY__
# Prisma CLI (runs `migrate deploy` on every boot) must not phone home.
CHECKPOINT_DISABLE=1
# Session cookie `secure` flag. Empty = secure (production default). install.sh
# sets "false" ONLY for --tls http — otherwise login over plain HTTP is
# impossible. Never set false when the site is served over HTTPS.
COOKIE_SECURE=__COOKIE_SECURE__

# --- App ---------------------------------------------------------------------
# TOF-0795 (Tarek 31.10.2026): instance name in the UI (install.sh --app-name).
# RUNTIME setting: change it here, then ./update.sh --restart. Empty = the
# default name of each language ("Task Tracker", Arabic "متعقب المهام", …).
APP_NAME=__APP_NAME__
# Workspace (tenant) created by install.sh — a re-run keeps using it.
TT_TENANT_NAME=__TT_TENANT_NAME__
# Installed from the on-premise package: hides the Android APK download (that
# APK is built for another server). Leave it at 1.
TT_ONPREM=1
# Language the login page comes up in, for visitors who have not picked one yet
# (ar | de | en). Each user's own choice always wins after login. Applied at
# runtime — ./update.sh --restart is enough after changing it.
DEFAULT_LOCALE=__DEFAULT_LOCALE__
# Build-time value for online builds (canonical links, sitemap, OG tags). The
# app prefers APP_URL below at runtime; pre-built offline images carry the
# neutral https://task-tracker.local here.
NEXT_PUBLIC_APP_URL=__APP_URL__
# Demo credentials block on the login page — MUST stay false in production.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=false

# --- Superuser account ---------------------------------------------------------
# Created once by install.sh (by invite link — no password is ever generated or
# shown; ./invite.sh mints a fresh link). Changing these values here does NOT
# change the existing login — use the app's own user administration instead.
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_EMAIL=__ADMIN_EMAIL__

# --- Optional integrations (all disabled by default) -------------------------
# Error tracking — https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Telegram notifications (bot token from @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Offline installs: leave everything in this block EMPTY — each of these is an
# outside service (docs/OFFLINE.md). A mail server inside your own network
# (SMTP_HOST=mail.intern) is fine.
# Outbound e-mail: either your own mail server (SMTP_*) OR Resend
# (RESEND_API_KEY). Empty: no e-mail is sent. EMAIL_FROM empty =
# "<APP_NAME> <noreply@<host of APP_URL>>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
# Address of this instance (no trailing slash): links in e-mails, invite links,
# canonical/OG links, the API description. Runtime — ./update.sh --restart.
APP_URL=__APP_URL__
# Voice-note transcription via a Whisper-compatible API.
VOICE_TRANSCRIPTION=false
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
