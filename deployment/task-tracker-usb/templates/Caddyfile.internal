# Task Tracker — Caddy config for ON-PREMISE / OFFLINE installs with HTTPS
# (generated by install.sh --tls internal, safe to edit).
# TOF-0794 (Tarek 31.10.2026).
#
# HTTPS WITHOUT the internet: every certificate comes from Caddy's own local
# certificate authority (CA), created on first start inside the caddy_data
# volume (/data/caddy/pki/authorities/local/root.crt). Nothing here talks to
# Let's Encrypt or any other outside service:
#   local_certs         no ACME issuer at all — the internal CA signs everything
#   skip_install_trust  do not try to install the root into a trust store
#   ocsp_stapling off   no OCSP fetches (the local CA has no responder anyway)
#   auto_https disable_redirects  port 80 is handled by the block below
#
# Devices trust the site once the ROOT certificate is imported — install.sh
# copies it to /opt/task-tracker/ca/task-tracker-root-ca.crt and it can also be
# downloaded from http://<server>/ca.crt (compare the fingerprint in ACCESS.txt).
#
# Clients that connect by IP address send no SNI; behind Docker's port mapping
# Caddy cannot see the host IP either, so default_sni selects the certificate.
#
# After editing:  docker compose restart caddy

{
	local_certs
	skip_install_trust
	ocsp_stapling off
	auto_https disable_redirects
	default_sni __DEFAULT_SNI__
	pki {
		ca local {
			name "__CA_NAME__"
			root_cn "__CA_NAME__ Root CA"
			intermediate_cn "__CA_NAME__ Intermediate CA"
		}
	}
}

__SITE_ADDRESSES__ {
	tls internal

	encode zstd gzip

	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Attachment uploads (the app's own server-action limit is 6 MB).
	request_body {
		max_size 12MB
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# Plain HTTP: hand out the root certificate (a public certificate, no secret),
# send everything else to HTTPS.
:80 {
	handle /ca.crt {
		root * /srv/ca
		rewrite * /task-tracker-root-ca.crt
		header Content-Type "application/x-x509-ca-cert"
		header Content-Disposition `attachment; filename="task-tracker-root-ca.crt"`
		file_server
	}
	handle {
		redir __PUBLIC_URL__{uri} permanent
	}
}
